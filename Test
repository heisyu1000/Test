      },
      plugins: {
        legend: {
          labels: {
            color: '#ffd700',
            font: { family: 'Press Start 2P', size: 10 }
          }
        }
      }
    }
  });
}

function renderScoreGrid(scores, sortedTypes) {
  const container = document.getElementById('score-cards');
  container.innerHTML = '';

  Object.keys(riasecMeta).forEach(type => {
    const meta = riasecMeta[type];
    const coinScore = scores[type];
    const isTop = sortedTypes.slice(0, 2).includes(type);

    const card = document.createElement('div');
    card.className = `riasec-card ${isTop ? 'top-rank' : ''}`;
    card.innerHTML = `
      <div>
        <h4>${meta.icon} ${meta.name}</h4>
        <p>${meta.title}</p>
      </div>
      <div class="score-badge">
        ${coinScore} 🪙
      </div>
    `;
    container.appendChild(card);
  });
}

