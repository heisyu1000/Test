      datasets: [{
        label: '已投金幣數 (🪙)',
        data: [scores.R, scores.I, scores.A, scores.S, scores.E, scores.C],
        backgroundColor: 'rgba(0, 240, 255, 0.25)',
        borderColor: '#00f0ff',
        borderWidth: 3,
        pointBackgroundColor: '#ffd700',
        pointBorderColor: '#000',
        pointBorderWidth: 2,
        pointRadius: 6,
        pointHoverRadius: 9
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      scales: {
        r: {
          angleLines: { color: 'rgba(168, 85, 247, 0.4)', lineWidth: 2 },
          grid: { color: 'rgba(168, 85, 247, 0.25)' },
          suggestedMin: 0,
          suggestedMax: 12,
          ticks: {
            stepSize: 2,
            color: '#ffd700',
