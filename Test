let radarChart = null;


function renderQuiz() {
  const wrapper = document.getElementById('quiz-wrapper');
  wrapper.innerHTML = '';

  quizData.forEach((cat, catIdx) => {
    const card = document.createElement('div');
    card.className = 'pixel-box cat-card';

    let coinSlots = '';
    for (let i = 0; i < cat.maxCoins; i++) {
      coinSlots += `<span class="pixel-coin" id="coin-slot-${catIdx}-${i}">🪙</span>`;
    }

    card.innerHTML = `
      <div class="cat-header">
        <div class="cat-title">${cat.category}</div>
        <div class="coin-slots">
          ${coinSlots}
          <span style="font-family: var(--font-pixel); font-size:0.75rem; color:var(--gold); margin-left:6px;" id="cat-coin-text-${catIdx}">0/6🪙</span>
        </div>
      </div>
      <div class="options-container">
        ${cat.items.map((item, itemIdx) => `
          <label class="option-item" id="label-${catIdx}-${itemIdx}">
            <input type="checkbox" 
                   id="chk-${catIdx}-${itemIdx}" 
                   data-cat="${catIdx}" 
                   data-type="${item.type}" 
                   data-weight="${item.weight}" 
                   onchange="handleOptionToggle(${catIdx}, ${itemIdx}, this)">
            <span class="option-text">${item.text}</span>
            <span class="coin-badge">+${item.weight} 🪙</span>
          </label>
        `).join('')}
      </div>
      <div class="warning-banner" id="warning-${catIdx}">
        ⚠️ 該範疇金幣上限為 6 金幣！
      </div>
    `;
    wrapper.appendChild(card);
  });
}

function handleOptionToggle(catIdx, itemIdx, checkbox) {
  const catCheckboxes = document.querySelectorAll(`input[data-cat="${catIdx}"]:checked`);
  let catCoins = 0;

  catCheckboxes.forEach(cb => {
    catCoins += parseInt(cb.dataset.weight);
  });

  const maxCoins = quizData[catIdx].maxCoins;
  const warningEl = document.getElementById(`warning-${catIdx}`);
  const labelEl = document.getElementById(`label-${catIdx}-${itemIdx}`);

  // Limit check
  if (catCoins > maxCoins) {
    checkbox.checked = false;
    playErrorSFX();
    warningEl.style.display = 'block';
    setTimeout(() => { warningEl.style.display = 'none'; }, 2500);
    return;
  }

  if (checkbox.checked) {
    labelEl.classList.add('selected');
    playCoinSFX();
  } else {
    labelEl.classList.remove('selected');
  }

  updateCategoryCoins(catIdx, catCoins);
  updateTotalHUD();
}

function updateCategoryCoins(catIdx, catCoins) {
  const maxCoins = quizData[catIdx].maxCoins;
  for (let i = 0; i < maxCoins; i++) {
    const coinEl = document.getElementById(`coin-slot-${catIdx}-${i}`);
    if (i < catCoins) {
      coinEl.classList.add('active');
    } else {
      coinEl.classList.remove('active');
    }
  }
  document.getElementById(`cat-coin-text-${catIdx}`).innerText = `${catCoins}/6🪙`;
}

function updateTotalHUD() {
  const allChecked = document.querySelectorAll('input[type="checkbox"]:checked');
  let usedCoins = 0;
  allChecked.forEach(cb => {
    usedCoins += parseInt(cb.dataset.weight);
  });

  const coinsLeft = 24 - usedCoins;
  document.getElementById('coins-left').innerText = coinsLeft;

  const hudCoinsBox = document.getElementById('hud-total-coins');
  if (coinsLeft === 0) {
    hudCoinsBox.style.borderColor = "var(--green)";
    hudCoinsBox.style.color = "var(--green)";
  } else {
    hudCoinsBox.style.borderColor = "var(--gold)";
    hudCoinsBox.style.color = "var(--gold)";
  }
}


document.getElementById('quiz-form').addEventListener('submit', function(e) {
  e.preventDefault();

  playVictorySFX();

  const scores = { R: 0, I: 0, A: 0, S: 0, E: 0, C: 0 };
  const allChecked = document.querySelectorAll('input[type="checkbox"]:checked');

  allChecked.forEach(cb => {
    const type = cb.dataset.type;
    const weight = parseInt(cb.dataset.weight);
    scores[type] += weight;
  });

  const sortedTypes = Object.keys(scores).sort((a, b) => scores[b] - scores[a]);
  const primaryCode = sortedTypes.slice(0, 3).join('');

  // Show Results
  const resultSec = document.getElementById('result-section');
  resultSec.style.display = 'block';
  resultSec.scrollIntoView({ behavior: 'smooth' });

  // Update Character Badges
  document.getElementById('archetype-code').innerText = primaryCode;
  
  const top1 = riasecMeta[sortedTypes[0]];
  const top2 = riasecMeta[sortedTypes[1]];
  document.getElementById('archetype-title').innerText = `${top1.icon} ${top1.title} × ${top2.title}`;

  // Render Radar Chart
  renderRadarChart(scores);

  // Render Score Breakdowns
  renderScoreGrid(scores, sortedTypes);

  // Render RPG Career Advice
  renderCareerAdvice(sortedTypes);
});

function renderRadarChart(scores) {
